    {"name": "top_right",    "position": [0.88, 0.88, 0.5]},
    {"name": "bottom",       "position": [0.50, 0.08, 0.5]},
    {"name": "bottom_left",  "position": [0.12, 0.10, 0.5]},
    {"name": "bottom_right", "position": [0.88, 0.10, 0.5]}
  ],
  "examples": [
